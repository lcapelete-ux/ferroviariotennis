# Applied by Netlify on ZIP (drag-and-drop) deploys, where netlify.toml is not present.
# Never cache the HTML shell so users always get the latest deploy...
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
# ...but hashed assets are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
